# Add these entries to the existing .env of evsi.store.
# Daily analysis limits: whole numbers >= 0; 0 means no analyses.
CCAI_FREE_ANALYSES_EXISTING=5
CCAI_FREE_ANALYSES_NEW=5

# Premium daily limits also accept the literal word unlimited.
CCAI_PREMIUM_ANALYSES_EXISTING=50
CCAI_PREMIUM_ANALYSES_NEW=50

# Exact boolean values: true or false (not falls).
CCAI_FIRST_DAY_FREE=false

# Keep the existing CalorieCounterAI API authentication variables in .env.
# This config route uses the same X-Client-Token as the analysis routes.
